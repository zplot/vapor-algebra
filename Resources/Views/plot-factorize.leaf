<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>#(title)</title>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
</head>
<body>
  <h1>#(title)</h1>
  <p>Descomposición en primos de <strong>#(n)</strong>.</p>

  <div id="chart" style="width:100%;max-width:800px;height:500px;"></div>

  <script id="chart-data" type="application/json">
    {"primes": #(primes), "exponents": #(exponents)}
  </script>

  <script>
    const data = JSON.parse(document.getElementById('chart-data').textContent);
    Plotly.newPlot('chart', [{
      x: data.primes.map(String),
      y: data.exponents,
      type: 'bar',
      marker: { color: '#4C78A8' },
      text: data.exponents.map(e => e.toString()),
      textposition: 'outside',
    }], {
      xaxis: { title: 'Primo', type: 'category' },
      yaxis: { title: 'Exponente', dtick: 1 },
      margin: { t: 20 },
    }, { responsive: true });
  </script>
</body>
</html>
