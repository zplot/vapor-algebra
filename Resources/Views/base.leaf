<!doctype html>
<html lang="es" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>#(title)</title>
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
          onload="renderMathInElement(document.body, { delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false}
          ]})"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
  <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="font-semibold text-lg tracking-tight text-white">zplot · álgebra</a>
      <div class="flex gap-4 text-sm text-slate-300">
        <a href="/factorize" class="hover:text-white">Factorizar</a>
        <a href="/plot/factorize/360" class="hover:text-white">Gráfico 2D</a>
        <a href="/plot/surface" class="hover:text-white">Superficie 3D</a>
      </div>
    </nav>
  </header>
  <main class="mx-auto max-w-5xl px-6 py-10">
    #import("body")
  </main>
  <footer class="mx-auto max-w-5xl px-6 py-8 text-sm text-slate-500">
    Vapor + Leaf + AlgebraPackage · desplegado en Railway
  </footer>
</body>
</html>
