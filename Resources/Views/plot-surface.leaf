#extend("base"):
  #export("body"):
    <section class="prose prose-invert max-w-none">
      <h1>Superficie 3D</h1>
      <p>Silla de montar $z = x^2 - y^2$ sobre $[-3, 3]^2$. Puedes rotar arrastrando con el ratón y ampliar con la rueda.</p>
    </section>

    <div id="chart" class="mt-6 h-[720px] rounded-lg border border-slate-800 bg-slate-900/40 p-2"></div>

    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
    <script id="chart-data" type="application/json">
      {"x": #(x), "y": #(y), "z": #(z)}
    </script>
    <script>
      const data = JSON.parse(document.getElementById('chart-data').textContent);
      Plotly.newPlot('chart', [{
        type: 'surface',
        x: data.x,
        y: data.y,
        z: data.z,
        colorscale: 'Viridis',
        colorbar: { thickness: 12, len: 0.7, x: 0.98, xpad: 0 },
        contours: {
          z: { show: true, usecolormap: true, project: { z: true } }
        }
      }], {
        paper_bgcolor: 'transparent',
        plot_bgcolor: 'transparent',
        font: { color: '#e2e8f0' },
        scene: {
          aspectmode: 'cube',
          xaxis: { title: 'x', color: '#94a3b8', gridcolor: '#334155' },
          yaxis: { title: 'y', color: '#94a3b8', gridcolor: '#334155' },
          zaxis: { title: 'z', color: '#94a3b8', gridcolor: '#334155' },
          camera: { eye: { x: 1.3, y: 1.3, z: 0.9 } },
          bgcolor: 'transparent'
        },
        margin: { l: 0, r: 0, t: 0, b: 0 }
      }, { responsive: true });
    </script>
  #endexport
#endextend
