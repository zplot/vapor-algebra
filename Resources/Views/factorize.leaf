<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>#(title)</title>
</head>
<body>
  <h1>#(title)</h1>

  <form action="/factorize" method="post">
    <label for="n">Número entero positivo:</label>
    <input type="number" id="n" name="n" min="1" required value="#(n)">
    <button type="submit">Factorizar</button>
  </form>

  #if(result):
    <h2>Resultado</h2>
    <p>#(n) = #(result)</p>
  #endif
</body>
</html>
